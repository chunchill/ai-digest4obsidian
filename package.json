    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "follow-builders",
    "ai",
    "digest"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
