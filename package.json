{
  "name": "ai-digest4obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin for syncing Follow Builders central feeds into Markdown notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
